# Senha da área interna (/admin), onde você marca os pedidos pagos via Pix.
# Escolha uma senha sua — não precisa ser complexa, é só pra você mesma.
ADMIN_PASSWORD=

# Seu e-mail (Lívia) - recebe um aviso a cada novo pedido feito no site.
ADMIN_NOTIFICATION_EMAIL=

# Chave de API do Resend (resend.com) - usada para enviar todos os e-mails
# transacionais (confirmação de pagamento, novo pedido, orçamento, envio).
# Sem essa chave, os e-mails simplesmente não são enviados (sem erro visível).
RESEND_API_KEY=

# Token de leitura/escrita do Vercel Blob (gerado automaticamente pela Vercel
# ao conectar o projeto a um Blob Store; necessário também em desenvolvimento
# local via `vercel env pull`).
BLOB_READ_WRITE_TOKEN=

# Chave Pix usada para gerar o QR Code de pagamento. Opcional: se não for
# definida, o código usa a chave já cadastrada como padrão.
PIX_KEY=
